# Copy to terraform.tfvars and adjust. NEVER commit real secrets.
# Prefer exporting the DB password:  export TF_VAR_db_password="..."

aws_region   = "us-east-1"
project_name = "ahmad-3tier"
vpc_cidr     = "10.0.0.0/16"

instance_type = "t3.micro"
asg_min       = 2
asg_max       = 4
asg_desired   = 2

db_instance_class = "db.t3.micro"
db_name           = "appdb"
db_username       = "admin"
# db_password     = "set-via-TF_VAR_db_password-instead"
db_multi_az       = true
